{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "day15",
  "account_id": "9b4d3e616e55585a0ae844f424717b43",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // The persona harnesses are markdown, bundled into the Worker as text.
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
  "assets": {
    "directory": "../../apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Every request runs the Worker first, so the old addresses below redirect to a-line.build40for40.com whatever the path.
    "run_worker_first": true
  },
  "routes": [
    // Deploying creates the custom domains and their DNS records.
    { "pattern": "a-line.build40for40.com", "custom_domain": true },
    { "pattern": "day15.build40for40.com", "custom_domain": true },
    { "pattern": "build40for40.com/day15", "zone_name": "build40for40.com" },
    { "pattern": "build40for40.com/day15/*", "zone_name": "build40for40.com" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "ProjectRoom" },
      { "name": "TEAMS", "class_name": "TeamDirectory" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ProjectRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["TeamDirectory"] }
  ],
  "workers_dev": true,
  "preview_urls": true,
  // Every MCP address holds a person's key, so request URLs stay out of the logs: only console output is kept.
  "observability": { "enabled": true, "logs": { "invocation_logs": false }, "traces": { "enabled": false } }
}
