{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "description": "The day15 Worker: the agency API under /api, the MCP server under /mcp, and the web app's static build.",
  "type": "module",
  "scripts": {
    "dev": "mkdir -p ../../apps/web/dist && pnpm wrangler dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "wrangler": "env -u CLOUDFLARE_API_KEY -u CLOUDFLARE_EMAIL wrangler --profile 40for40"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.94",
    "@cfworker/json-schema": "^4.1.6",
    "@day15/shared": "workspace:*",
    "@modelcontextprotocol/server": "2.4.0",
    "agents": "0.33.0",
    "ai": "^7.0.159",
    "jose": "^6.2.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261102.1",
    "typescript": "~6.0.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.156.1"
  }
}
