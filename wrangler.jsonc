{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "day15",
  "account_id": "9b4d3e616e55585a0ae844f424717b43",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "run_worker_first": ["/day15/api/*"]
  },
  "routes": [
    { "pattern": "build40for40.com/day15", "zone_name": "build40for40.com" },
    { "pattern": "build40for40.com/day15/*", "zone_name": "build40for40.com" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "ProjectRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ProjectRoom"] }],
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true }
}
