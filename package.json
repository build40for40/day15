{
  "name": "day15",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "pnpm --parallel --filter web --filter api dev",
    "fake": "pnpm --filter web fake",
    "build": "pnpm typecheck && pnpm --filter web build",
    "preview": "pnpm --filter web preview",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "wrangler": "pnpm --filter api wrangler",
    "deploy": "pnpm build && pnpm wrangler deploy"
  },
  "engines": {
    "node": ">=24.12.0"
  }
}
